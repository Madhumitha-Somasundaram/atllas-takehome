{
  "name": "takehome",
  "scripts": {
    "start": "node scripts/run.mjs",
    "seed": "ts-node --transpileOnly scripts/seed.ts",
    "seed-prod": "ts-node --transpileOnly scripts/seed.ts --full",
    "bundle": "node scripts/bundle.mjs",
    "prepare-submission": "node scripts/bundle.mjs",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces"
  },
  "workspaces": [
    "packages/front-end",
    "packages/back-end"
  ],
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "next": "^13.5.7",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "react-international-phone": "^4.8.0",
    "zod": "^3.24.1"
  }
